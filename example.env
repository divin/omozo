# llama-server embedding endpoint (OpenAI-compatible /v1/embeddings).
OMOZO_EMBED_URL=http://host.docker.internal:8081
OMOZO_EMBED_MODEL=bge-m3

# Rerank endpoint; leave unset to disable reranking (Phase 3).
OMOZO_RERANK_URL=
OMOZO_RERANK_MODEL=bge-reranker-v2-m3

# Optional bearer token for the MCP endpoint; leave unset for trusted LAN use.
# OMOZO_MCP_TOKEN=replace-with-a-long-random-token

# Compact tool responses: max characters per memory/chunk preview.
OMOZO_PREVIEW_CHARS=600
# Same-kind cosine similarity at which a new memory supersedes an old one.
OMOZO_DEDUPE_THRESHOLD=0.92

# Confidence floors (cosine) for vector-only search hits, per route.
# FTS-matched hits are always exempt. Calibrate against real queries
# (set OMOZO_DEBUG_SCORES=1 to print scores); defaults are bge-m3 priors.
OMOZO_MEMORY_MIN_SIM=0.35
OMOZO_DOC_MIN_SIM=0.35
# Relative gap: drop hits below this ratio of the best hit's score.
# 0 disables the rule.
OMOZO_RELATIVE_GAP=0.75
# Append similarity scores to search results (calibration aid).
# OMOZO_DEBUG_SCORES=1

# Host paths. DOCS_DIR is mounted read-only (used from Phase 2 on).
HOST_DATA_DIR=./data
# HOST_DOCS_DIR=/srv/docs
OMOZO_PORT=9095
TZ=Europe/Berlin
